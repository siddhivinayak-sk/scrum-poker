# Patterns to ignore when building packages.
# This supports shell glob matching, relative path matching, and
# negation (prefixed with !). Only one pattern per line.
.DS_Store

# Common VCS directories
.git/
.gitignore
.gitattributes
.bzr/
.bzrignore
.hg/
.hgignore
.svn/

# Common backup files
*.swp
*.bak
*.tmp
*.orig
*~

# Various IDEs and editors
.project
.idea/
.vscode/
*.tmproj
*.sublime-project
*.sublime-workspace

# Packaged charts
*.tgz

# CI and OS noise
.github/
Thumbs.db
